#!/bin/sh
# put in .git/hooks/pre-commit

# Set the maximum allowed size in bytes (10KB = 10240 bytes)
MAX_SIZE=10240

# Get a list of all staged file paths
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

for FILE in $STAGED_FILES; do
    # Verify the file still exists on disk
    if [ -f "$FILE" ]; then
        # Get file size in bytes
        FILE_SIZE=$(wc -c < "$FILE")

        if [ "$FILE_SIZE" -gt "$MAX_SIZE" ]; then
            echo "Error: $FILE is $(($FILE_SIZE / 1024))KB. Maximum allowed size is 10KB."
            exit 1
        fi
    fi
done

